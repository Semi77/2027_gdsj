<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- 舵机角度节点使用UDP，避免跨容器共享内存隔离造成只发现节点却收不到消息。 -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>servo_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="servo_participant" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>servo_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
